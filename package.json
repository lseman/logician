{
	"name": "@logician/logician-tui",
	"version": "0.2.0",
	"description": "Terminal TUI for Logician — SSH-ready, streaming-first, thinking-visible, pi-style input",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"tui/packages/*"
	],
	"scripts": {
		"dev": "tsx tui/packages/tui/src/index.ts",
		"start": "tsx tui/packages/tui/src/index.ts",
		"ariadne:build": "cargo build --release --manifest-path ariadne/Cargo.toml --package ariadne-graph",
		"ariadne:check": "cargo test --manifest-path ariadne/Cargo.toml --workspace",
		"lint": "biome check tui/packages/",
		"lint:fix": "biome check --fix tui/packages/",
		"format": "biome format --write tui/packages/",
		"format:check": "biome check --linter-enabled=false tui/packages/",
		"bench:keystroke": "tsx tui/packages/tui/src/__tests__/benchmark-keystroke.ts",
		"bench:latency": "tsx tui/packages/tui/src/__tests__/benchmark-latency.ts",
		"eval:smoke": "bun run --filter @logician/agent-eval eval:smoke",
		"test": "bun run --workspaces --if-present test",
		"typecheck": "bun run --workspaces --if-present typecheck",
		"ci": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@sinclair/typebox": "^0.34.41",
		"@types/bun": "^1.3.14",
		"bun-types": "^1.3.14",
		"tsx": "^4.23.1",
		"tui": "^1.0.0",
		"typescript": "5.7.2"
	}
}
