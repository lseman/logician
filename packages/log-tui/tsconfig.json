{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDir": "..",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": {
			"@logician/log-core": ["../log-core/src/index.ts"],
			"@logician/log-core/events": [
				"../log-core/src/types/events.ts"
			],
			"@logician/log-core/protocol": [
				"../log-core/src/types/protocol.ts"
			]
		},
		"types": ["node", "bun-types"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
