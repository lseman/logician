	"dependencies": {
		"@logician/log-core": "0.2.0",
		"@logician/log-rag": "0.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
