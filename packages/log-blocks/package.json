{
	"name": "@logician/log-blocks",
	"version": "0.2.0",
	"private": true,
	"description": "Agent feature modules for Logician — todo, ask-user, subagents, reasoners, eoh",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./tools": "./src/tools.ts",
