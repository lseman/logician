{
	"name": "@logician/log-runtime",
	"version": "0.2.0",
	"private": true,
	"description": "Logician runtime composition — capabilities, integrations, configuration, and TUI-facing application services",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./adapters/claude-code": "./src/adapters/claude-code/index.ts",
		"./application": "./src/runtime/index.ts",
		"./commands": "./src/capabilities/commands/index.ts",
		"./configuration": "./src/runtime/configuration/index.ts",
		"./configuration/runtime": "./src/runtime/configuration/runtime-config.ts",
		"./context": "./src/runtime/context/index.ts",
		"./developer-tools": "./src/developer-tools.ts",
		"./formatting": "./src/formatting.ts",
		"./reasoning": "./src/capabilities/reasoning/index.ts",
		"./sessions": "./src/runtime/session/index.ts",
		"./skills": "./src/capabilities/skills/loader.ts",
		"./tools": "./src/tools.ts",
		"./trust": "./src/runtime/trust/index.ts"
	},
	"scripts": {
		"test": "bun test $(find src -name '*.test.ts' -type f -print)",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/log-core": "0.2.0",
		"@logician/log-autoresearch": "0.2.0",
		"@logician/log-eoh": "0.1.0",
		"@logician/memoriam": "link:@logician/memoriam",
		"@logician/log-rag": "0.2.0",
		"emphasize": "^7.0.0",
		"ignore": "^7.0.5"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
