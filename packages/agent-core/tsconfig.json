{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "..",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"composite": true,
		"noEmit": true,
		"types": ["node", "bun-types"],
		"paths": {
			"@logician/eoh/*": ["../eoh/src/*"]
		}
	},
	"include": ["src/**/*", "../eoh/src/**/*"],
	"exclude": ["node_modules", "dist"]
}
