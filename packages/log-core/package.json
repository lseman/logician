{
	"name": "@logician/log-core",
	"version": "0.2.0",
	"private": true,
	"description": "Lean agent engine for Logician \u2014 loop, harness, hooks, types",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./harness": "./src/loop/agent-harness.ts",
		"./session": "./src/harness/agent-session.ts",
		"./evaluation": "./src/evaluation/trajectory.ts",
		"./frontmatter": "./src/config/frontmatter.ts",
		"./hooks/native": "./src/hooks/hook-bus.ts",
		"./permissions": "./src/tools/permissions.ts",
		"./protocol": "./src/types/protocol.ts",
		"./events": "./src/types/events.ts",
		"./event-journal": "./src/events/event-journal.ts",
		"./types-messages": "./src/types/messages.ts"
	},
	"scripts": {
		"test": "bun test $(find src -name '*.test.ts' -type f -print)",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/log-natives": "workspace:*",
		"@logician/log-snapcompact": "workspace:*",
		"ignore": "^6.0.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
