{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"lib": ["ES2022"],
		"types": ["bun-types"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "__tests__/**/*.ts"],
	"exclude": ["node_modules"]
}
