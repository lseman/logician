{
	"name": "@logician/tui",
	"version": "0.2.0",
	"private": true,
	"description": "Terminal TUI layer for Logician",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"start": "tsx src/index.ts",
		"test": "tsx --test $(find src -name '*.test.ts' -type f -print)",
		"bench": "tsx packages/tui/src/__tests__/benchmark.ts",
		"bench:keystroke": "tsx packages/tui/src/__tests__/benchmark-keystroke.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/agent-capabilities": "0.2.0",
		"@logician/agent-core": "0.2.0",
		"@logician/coding-agent": "0.2.0",
		"string-width": "^8.2.2"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^10.8.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
