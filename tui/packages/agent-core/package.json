{
	"name": "@logician/agent-core",
	"version": "0.2.0",
	"private": true,
	"description": "Lean agent engine for Logician — loop, harness, hooks, types",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./agent/*": "./src/agent/*",
		"./tools/*": "./src/tools/*",
		"./builtins/*": "./src/hooks/builtin/*",
		"./extensions/*": "./src/extensions/*",
		"./hooks/*": "./src/hooks/*",
		"./hooks/native": "./src/hooks/native/index.ts",
		"./hooks/builtin": "./src/hooks/builtin/index.ts",
		"./hooks/extensions": "./src/hooks/extensions/index.ts",
		"./plugins/claude-code": "./src/plugins/claude-code/index.ts",
		"./compaction/*": "./src/compaction/*",
		"./queue/*": "./src/queue/*"
	},
	"scripts": {
		"test": "tsx --test $(find src -name '*.test.ts' -type f -print)",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"emphasize": "^7.0.0",
		"ignore": "^7.0.5",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
