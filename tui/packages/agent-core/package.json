{
	"name": "@logician/agent-core",
	"version": "0.2.0",
	"description": "Lean agent engine for Logician — loop, harness, hooks, types",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./core/*": "./src/core/*",
		"./tools/*": "./src/tools/*",
		"./extensions/*": "./src/extensions/*",
		"./hooks/*": "./src/hooks/*",
		"./compaction/*": "./src/compaction/*",
		"./message-queue/*": "./src/message-queue/*"
	},
	"scripts": {
		"test": "tsx src/__tests__/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"emphasize": "^7.0.0",
		"ignore": "^7.0.5",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.5.0"
	}
}
