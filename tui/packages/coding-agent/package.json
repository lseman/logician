{
	"name": "@logician/coding-agent",
	"version": "0.2.0",
	"description": "Orchestration layer for Logician — sessions, config, skills, slash commands, model resolution",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./bridge": "./src/runtime/bridge.ts",
		"./session-store": "./src/sessions/session-store.ts",
		"./config": "./src/configuration/config.ts",
		"./slash-commands": "./src/commands/slash-commands.ts",
		"./transcript": "./src/sessions/transcript.ts",
		"./events": "./src/runtime/events.ts",
		"./loop-manager": "./src/runtime/loop-manager.ts",
		"./runtime": "./src/runtime/index.ts",
		"./sessions": "./src/sessions/index.ts",
		"./configuration": "./src/configuration/index.ts",
		"./commands": "./src/commands/index.ts",
		"./mcp": "./src/mcp/index.ts",
		"./mcp/*": "./src/mcp/*",
		"./skills": "./src/skills.ts",
		"./system-prompt": "./src/system-prompt.ts",
		"./context-files": "./src/context-files/index.ts",
		"./context-files/*": "./src/context-files/*",
		"./prompts": "./src/prompts/index.ts",
		"./prompts/*": "./src/prompts/*",
		"./trust": "./src/trust/index.ts",
		"./trust/*": "./src/trust/*",
		"./tools": "./src/tools/index.ts",
		"./tools/*": "./src/tools/*",
		"./file-mentions": "./src/file-mentions.ts"
	},
	"scripts": {
		"test": "tsx --test src/__tests__/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/agent-core": "0.2.0",
		"@logician/agent-capabilities": "0.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.5.0",
		"bun-types": "^1.0.0"
	}
}
