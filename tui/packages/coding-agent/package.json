{
	"name": "@logician/coding-agent",
	"version": "0.2.0",
	"description": "Orchestration layer for Logician — sessions, config, skills, slash commands, model resolution",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./runtime": "./src/runtime/index.ts",
		"./application": "./src/application/index.ts",
		"./context": "./src/context/index.ts",
		"./developer-tools": "./src/developer-tools/index.ts",
		"./sessions": "./src/sessions/index.ts",
		"./configuration": "./src/configuration/index.ts",
		"./commands": "./src/commands/index.ts",
		"./mcp": "./src/mcp/index.ts",
		"./mcp/*": "./src/mcp/*",
		"./skills": "./src/skills/index.ts",
		"./skills/*": "./src/skills/*",
		"./prompts": "./src/prompts/index.ts",
		"./prompts/*": "./src/prompts/*",
		"./trust": "./src/trust/index.ts",
		"./trust/*": "./src/trust/*",
		"./tools": "./src/tools/index.ts",
		"./tools/*": "./src/tools/*"
	},
	"scripts": {
		"test": "tsx --test $(find src -name '*.test.ts' -type f -print)",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/agent-core": "0.2.0",
		"@logician/agent-capabilities": "0.2.0",
		"ignore": "^7.0.5"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"bun-types": "^1.0.0"
	}
}
