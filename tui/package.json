{
	"name": "@logician/logician-tui",
	"version": "0.2.0",
	"description": "Terminal TUI for Logician — SSH-ready, streaming-first, thinking-visible, pi-style input",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "tsx packages/tui/src/index.ts",
		"start": "tsx packages/tui/src/index.ts",
		"lint": "packages/tui/node_modules/.bin/eslint --config packages/tui/eslint.config.js packages/",
		"lint:fix": "packages/tui/node_modules/.bin/eslint --config packages/tui/eslint.config.js packages/ --fix",
		"test": "tsx --test $(find packages -name '*.test.ts' -type f -print)",
		"typecheck": "bun run --workspaces --if-present typecheck",
		"ci": "bun run typecheck && bun run lint && bun run test"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"bun-types": "^1.3.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
