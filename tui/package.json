{
	"name": "@logician/logician-tui",
	"version": "0.2.0",
	"description": "Terminal TUI for Logician — SSH-ready, streaming-first, thinking-visible, pi-style input",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "tsx packages/tui/src/index.ts",
		"start": "tsx packages/tui/src/index.ts",
		"lint": "eslint packages/",
		"lint:fix": "eslint packages/ --fix",
		"test": "tsx packages/agent-core/src/__tests__/*.test.ts",
		"typecheck": "tsc --noEmit -p packages/agent-core/tsconfig.json -p packages/coding-agent/tsconfig.json -p packages/tui/tsconfig.json"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"bun-types": "^1.3.14"
	}
}
