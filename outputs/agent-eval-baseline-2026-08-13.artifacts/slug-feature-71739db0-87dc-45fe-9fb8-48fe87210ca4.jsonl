{"type":"tool_result","id":"ymWDSRrTiMZc3HolO4jfTz4TZ7j9vLdA","name":"read_file","output":"export interface SlugOptions {\n\tmaxLength?: number;\n}\n\nexport function slugify(value: string, options: SlugOptions = {}): string {\n\t// 1. Normalize to NFD so diacritics split into base + combining marks\n\tlet slug = value.normalize(\"NFD\");\n\n\t// 2. Strip combining diacritical marks\n\tslug = slug.replace(/[\\u0300-\\u036f]/g, \"\");\n\n\t// 3. Lowercase\n\tslug = slug.toLowerCase();\n\n\t// 4. Replace any sequence of non-alphanumeric characters with a single hyphen\n\tslug = slug.replace(/[^a-z0-9]+/g, \"-\");\n\n\t// 5. Trim leading/trailing hyphens\n\tslug = slug.replace(/^-|-$/g, \"\");\n\n\t// 6. Truncate at word boundary if maxLength is set\n\tif (options.maxLength != null && options.maxLength > 0 && slug.length > options.maxLength) {\n\t\tslug = slug.slice(0, options.maxLength);\n\t\t// Trim back to the last hyphen (word boundary) to avoid cutting mid-word\n\t\tconst lastHyphen = slug.lastIndexOf(\"-\");\n\t\tif (lastHyphen > 0) {\n\t\t\tslug = slug.slice(0, lastHyphen);\n\t\t} else {\n\t\t\tslug = \"\";\n\t\t}\n\t}\n\n\treturn slug;\n}\n","status":"success","started_at":"2026-08-13T11:58:17.790Z","completed_at":"2026-08-13T11:58:17.793Z","duration_ms":3,"schema":"logician.exec-stream","schema_version":1,"run_id":"exec_3f590d9b-62dc-4014-94d1-3529e673b73d"}
