        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "eslint": "^10.4.1",
        "tsx": "^4.0.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
