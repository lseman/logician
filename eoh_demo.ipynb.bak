   "source": [
    "from src.eoh.runner import run_eoh\n",
    "\n",
    "TASK_DESC = (\n",
    "    \"Evolve a generic heuristic policy (hook dict) to improve the metaheuristic's \"\n",
    "    \"performance on the given ProblemAPI. \"\n",
    "    \"Optimise for: feasibility, fast convergence, and stable improvements across \"\n",
    "    \"different random seeds.\"\n",
    ")\n",
    "\n",
    "result = run_eoh(\n",
    "    agent,\n",
    "    task_desc=TASK_DESC,\n",
    "    api_desc=example_api_desc(),\n",
    "    eval_spec=eval_spec,\n",
    "    cfg=cfg,\n",
    "    rng_seed=42,\n",
    ")\n",
    "\n",
    "print(\"EoH complete.\")\n",
    "print(f\"Best fitness : {result.best.fitness:.4f}\")\n",
    "print(f\"Hall of fame : {len(result.hall_of_fame)} individuals\")\n",
    "print(f\"Generations  : {len(result.history)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9235cfa7",
   "metadata": {},
   "source": [
    "## 6. Inspect the Best Individual"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa6c5e9d",
   "metadata": {},
   "outputs": [],
   "source": [
    "best = result.best\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(f\"ID          : {best.id}\")\n",
    "print(f\"Generation  : {best.generation}\")\n",
    "print(f\"Fitness     : {best.fitness:.6f}\")\n",
    "print(f\"Parents     : {best.parents}\")\n",
    "print(f\"Hook impls  : {best.metrics.get('hook_impl', [])}\")\n",
    "print()\n",
    "print(\"[THOUGHT]\")\n",
    "print(best.thought or \"(none)\")\n",
    "print()\n",
    "print(\"[CODE]\")\n",
    "print(best.code)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58b4d0d1",
   "metadata": {},
   "source": [
    "## 7. Hall of Fame"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "508e33b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"{'Rank':<5} {'ID':<14} {'Gen':<5} {'Fitness':>10}  Hook impls\")\n",
    "print(\"-\" * 70)\n",
    "for rank, ind in enumerate(result.hall_of_fame, 1):\n",
    "    hooks = \", \".join(ind.metrics.get(\"hook_impl\", [])) or \"-\"\n",
    "    print(f\"{rank:<5} {ind.id:<14} {ind.generation:<5} {ind.fitness:>10.4f}  {hooks}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bd03968a",
   "metadata": {},
   "source": [
    "## 8. Convergence History"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f56eaad6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "\n",
    "# Each entry in result.history is a dict with at least 'generation' and 'best_fitness'\n",
    "print(f\"{'Gen':<5} {'Best fitness':>14} {'Pop best':>12}\")\n",
    "print(\"-\" * 36)\n",
    "for entry in result.history:\n",
    "    gen  = entry.get(\"generation\", \"?\")\n",
    "    best_f = entry.get(\"best_fitness\", float(\"nan\"))\n",
    "    pop_b  = entry.get(\"pop_best_fitness\", float(\"nan\"))\n",
    "    print(f\"{gen:<5} {best_f:>14.4f} {pop_b:>12.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a200aa17",
   "metadata": {},
   "source": [
    "## 9. Plot Convergence (optional — requires matplotlib)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9cbfcd3a",
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    gens      = [e[\"generation\"]        for e in result.history]\n",
    "    best_fits = [e.get(\"best_fitness\", float(\"nan\")) for e in result.history]\n",
    "    pop_bests = [e.get(\"pop_best_fitness\", float(\"nan\")) for e in result.history]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8, 4))\n",
    "    ax.plot(gens, best_fits, marker=\"o\", label=\"Hall-of-fame best\", linewidth=2)\n",
    "    ax.plot(gens, pop_bests, marker=\"s\", linestyle=\"--\", label=\"Population best\")\n",
    "    ax.set_xlabel(\"Generation\")\n",
    "    ax.set_ylabel(\"Fitness\")\n",
    "    ax.set_title(\"EoH convergence — SphereProblem\")\n",
    "    ax.legend()\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "except ImportError:\n",
    "    print(\"matplotlib not installed — skipping plot.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5d56cb47",
   "metadata": {},
   "source": [
    "## 10. Validate Best Heuristic on Hold-out Instances\n",
    "\n",
    "Re-evaluate the best individual on the validation set to get an unbiased \n",
    "performance estimate."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2b772ccc",
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.eoh.safety import compile_hooks\n",
    "from src.eoh.metaheuristics.ga import GeneticAlgorithm, GAConfig\n",
    "from src.eoh.types import Budget\n",
    "import statistics\n",
    "\n",
    "# Compile best heuristic code into a hooks dict\n",
    "hooks = compile_hooks(best.code)\n",
    "\n",
    "val_ga  = GeneticAlgorithm(GAConfig(pop_size=24))\n",
    "val_bud = Budget(max_iters=200, max_time_s=0.5)\n",
    "rng     = random.Random(99)\n",
    "\n",
    "objs: list[float] = []\n",
    "for inst in valid_instances:\n",
    "    trace = val_ga.run(problem, inst, hooks, val_bud, rng)\n",
    "    objs.append(trace.best_obj)\n",
    "\n",
    "print(f\"Validation results over {len(valid_instances)} instances:\")\n",
    "print(f\"  mean  obj : {statistics.mean(objs):.6f}\")\n",
    "print(f\"  stdev obj : {statistics.stdev(objs):.6f}\")\n",
    "print(f\"  best  obj : {min(objs):.6f}\")\n",
    "print(f\"  worst obj : {max(objs):.6f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9182bbce",
   "metadata": {},
   "source": [
    "## 11. Save / Load Best Individual\n",
    "\n",
    "Persist the best heuristic for reuse outside of EoH."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fefbc675",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from dataclasses import asdict\n",
    "\n",
    "OUT_PATH = Path(\"/tmp/eoh_best.json\")\n",
    "\n",
    "payload = {\n",
    "    \"id\":         best.id,\n",
    "    \"generation\": best.generation,\n",
    "    \"fitness\":    best.fitness,\n",
    "    \"thought\":    best.thought,\n",
    "    \"code\":       best.code,\n",
    "    \"metrics\":    best.metrics,\n",
    "    \"parents\":    best.parents,\n",
    "}\n",
    "OUT_PATH.write_text(json.dumps(payload, indent=2))\n",
    "print(f\"Saved to {OUT_PATH}\")\n",
    "\n",
    "# --- reload ---\n",
    "loaded = json.loads(OUT_PATH.read_text())\n",
    "print(\"Loaded fitness:\", loaded[\"fitness\"])\n",
    "hooks_reloaded = compile_hooks(loaded[\"code\"])\n",
    "print(\"Hooks reloaded:\", list(hooks_reloaded.keys()))"
   ]
  }
 ],
