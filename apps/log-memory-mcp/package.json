{
	"name": "@logician/log-memory-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Stdio MCP adapter for @logician/memoriam",
	"type": "module",
	"bin": {
		"logician-memory-mcp": "src/index.ts"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"test": "find src -name '*.test.ts' -type f -print0 | xargs -0 -r bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@logician/memoriam": "link:@logician/memoriam"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^22.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
